BAMBIKU_APP_NAME=BamBiku API
BAMBIKU_ENV=development
BAMBIKU_LOG_LEVEL=INFO
BAMBIKU_LOG_FORMAT=plain
BAMBIKU_PUBLIC_BASE_URL=http://127.0.0.1:5500
BAMBIKU_API_BASE_URL=http://127.0.0.1:8000/api

BAMBIKU_SECRET_KEY=change-me-to-a-long-random-secret
BAMBIKU_DATABASE_URL=sqlite:///./bambiku.db
BAMBIKU_RUN_MIGRATIONS_ON_STARTUP=true
BAMBIKU_ACCESS_TOKEN_EXPIRE_MINUTES=15
BAMBIKU_REFRESH_TOKEN_EXPIRE_DAYS=7
BAMBIKU_REFRESH_COOKIE_NAME=bk_refresh_token
BAMBIKU_REFRESH_COOKIE_SECURE=false
BAMBIKU_REFRESH_COOKIE_SAMESITE=lax
BAMBIKU_FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
BAMBIKU_RATE_LIMIT_AUTH=5/minute
BAMBIKU_RATE_LIMIT_AUTH_HOUR=25/hour
BAMBIKU_RATE_LIMIT_REFRESH=20/minute
BAMBIKU_RATE_LIMIT_CASHIER=8/minute
BAMBIKU_RATE_LIMIT_ADMIN_MONEY=20/minute
BAMBIKU_RATE_LIMIT_VIP_CLICKER=120/minute
BAMBIKU_RATE_LIMIT_VIP_PURCHASE=10/minute
BAMBIKU_ADMIN_EMAILS=

# PostgreSQL example for production-demo:
# BAMBIKU_DATABASE_URL=postgresql+psycopg://bambiku:change-me@127.0.0.1:5432/bambiku

# Do not commit real OAuth secrets, SECRET_KEY, Postgres passwords, or admin emails.

# Google OAuth. Create credentials in Google Cloud Console and set redirect URI:
# http://127.0.0.1:8000/api/auth/google/callback
BAMBIKU_GOOGLE_CLIENT_ID=
BAMBIKU_GOOGLE_CLIENT_SECRET=
BAMBIKU_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
BAMBIKU_GOOGLE_SUCCESS_REDIRECT=http://127.0.0.1:5500/index.html

# Telegram OIDC. In @BotFather: Bot Settings > Web Login.
# Register your public frontend origin and this redirect URI as Allowed URLs.
# Local 127.0.0.1 usually needs a public HTTPS tunnel such as ngrok.
BAMBIKU_TELEGRAM_CLIENT_ID=
BAMBIKU_TELEGRAM_CLIENT_SECRET=
BAMBIKU_TELEGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/auth/telegram/callback
BAMBIKU_TELEGRAM_SUCCESS_REDIRECT=http://127.0.0.1:5500/index.html
BAMBIKU_TELEGRAM_SCOPES=openid profile
