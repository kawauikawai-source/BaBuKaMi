BAMBIKU_APP_NAME=BamBiku API
BAMBIKU_ENV=production
BAMBIKU_LOG_LEVEL=INFO
BAMBIKU_LOG_FORMAT=json
BAMBIKU_PUBLIC_BASE_URL=https://casino.example.com
BAMBIKU_API_BASE_URL=https://casino.example.com/api

BAMBIKU_SECRET_KEY=replace-with-a-long-random-production-demo-secret
BAMBIKU_DATABASE_URL=postgresql+psycopg://bambiku:replace-password@db:5432/bambiku
BAMBIKU_RUN_MIGRATIONS_ON_STARTUP=true
BAMBIKU_ACCESS_TOKEN_EXPIRE_MINUTES=15
BAMBIKU_REFRESH_TOKEN_EXPIRE_DAYS=7
BAMBIKU_REFRESH_COOKIE_NAME=bk_refresh_token
BAMBIKU_REFRESH_COOKIE_SECURE=true
BAMBIKU_REFRESH_COOKIE_SAMESITE=lax
BAMBIKU_FRONTEND_ORIGINS=https://casino.example.com
BAMBIKU_RATE_LIMIT_AUTH=5/minute
BAMBIKU_RATE_LIMIT_AUTH_HOUR=25/hour
BAMBIKU_RATE_LIMIT_REFRESH=20/minute
BAMBIKU_RATE_LIMIT_CASHIER=8/minute
BAMBIKU_RATE_LIMIT_ADMIN_MONEY=20/minute
BAMBIKU_RATE_LIMIT_VIP_CLICKER=120/minute
BAMBIKU_RATE_LIMIT_VIP_PURCHASE=10/minute
BAMBIKU_ADMIN_EMAILS=

# Do not commit the real copied backend/.env.production file.
# Do not commit OAuth secrets, SECRET_KEY, Postgres passwords, or admin emails.

BAMBIKU_GOOGLE_CLIENT_ID=
BAMBIKU_GOOGLE_CLIENT_SECRET=
BAMBIKU_GOOGLE_REDIRECT_URI=https://casino.example.com/api/auth/google/callback
BAMBIKU_GOOGLE_SUCCESS_REDIRECT=https://casino.example.com/index.html

BAMBIKU_TELEGRAM_CLIENT_ID=
BAMBIKU_TELEGRAM_CLIENT_SECRET=
BAMBIKU_TELEGRAM_REDIRECT_URI=https://casino.example.com/api/auth/telegram/callback
BAMBIKU_TELEGRAM_SUCCESS_REDIRECT=https://casino.example.com/index.html
BAMBIKU_TELEGRAM_SCOPES=openid profile

# Render single-service mode. Render supplies RENDER_EXTERNAL_URL automatically.
# BAMBIKU_SERVE_FRONTEND=true
# BAMBIKU_FRONTEND_DIST_DIR=../dist
# BAMBIKU_RUN_MIGRATIONS_ON_STARTUP=false
# BAMBIKU_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
