POSTGRES_DB=bambiku
POSTGRES_USER=bambiku
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

BAMBIKU_ENV=production
BAMBIKU_LOG_LEVEL=INFO
BAMBIKU_LOG_FORMAT=json
BAMBIKU_PUBLIC_BASE_URL=http://127.0.0.1:5500
BAMBIKU_API_BASE_URL=http://127.0.0.1:5500/api
BAMBIKU_FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

FRONTEND_PORT=5500
BACKEND_PORT=8000

# Copy this file to .env for Docker Compose.
# Do not commit the real .env file.
